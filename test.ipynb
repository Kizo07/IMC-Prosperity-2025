    "filtered_diff = df_m['squid_kelp_diff'][(df_m['squid_kelp_diff'] > lower_percentile) & \n",
    "                                       (df_m['squid_kelp_diff'] < upper_percentile)]\n",
    "\n",
    "# Plot KDE with filtered data\n",
    "sns.kdeplot(data=filtered_diff.dropna(), fill=True)\n",
    "plt.axvline(x=0, color='r', linestyle='--', alpha=0.7)\n",
    "plt.title('Distribution of SQUID_INK vs KELP Return Differences (1%-99% range)', fontsize=14)\n",
