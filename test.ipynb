    "def plot_kde_with_outlier_removal(df, column_name, lower_pct=0.01, upper_pct=0.99, figsize=(12, 6)):\n",
    "    \n",
    "    plt.figure(figsize=figsize)\n",
    "    \n",
    "    # Calculate percentiles and filter data\n",
    "    lower_percentile = df[column_name].quantile(lower_pct)\n",
    "    upper_percentile = df[column_name].quantile(upper_pct)\n",
    "    filtered_data = df[column_name][(df[column_name] > lower_percentile) & \n",
    "                                   (df[column_name] < upper_percentile)]\n",
    "    \n",
    "    # Plot KDE with filtered data\n",
    "    sns.kdeplot(data=filtered_data.dropna(), fill=True)\n",
    "    plt.axvline(x=0, color='r', linestyle='--', alpha=0.7)\n",
    "    plt.title(f'Distribution of {column_name} ({lower_pct*100}%-{upper_pct*100}% range)', \n",
    "             fontsize=14)\n",
    "    plt.xlabel(column_name)\n",
    "    plt.ylabel('Density')\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Add summary statistics\n",
    "    mean_val = filtered_data.mean()\n",
    "    std_val = filtered_data.std()\n",
    "    plt.annotate(f'Mean: {mean_val:.4f}\\nStd: {std_val:.4f}\\n'\n",
    "                f'Range: [{lower_percentile:.4f}, {upper_percentile:.4f}]', \n",
    "                xy=(0.05, 0.95), xycoords='axes fraction',\n",
    "                bbox=dict(boxstyle=\"round,pad=0.3\", fc=\"white\", ec=\"b\", lw=1))\n",
    "    \n",
    "    plt.show()\n",
    "    \n",
    "    # Print additional statistics\n",
    "    n_removed = len(df[column_name]) - len(filtered_data)\n",
    "    pct_removed = (n_removed / len(df[column_name])) * 100\n",
    "    print(f\"Number of observations removed: {n_removed}\")\n",
    "    print(f\"Percentage of data removed: {pct_removed:.2f}%\")\n",
    "\n",
    "# For the squid-kelp difference\n",
    "#plot_kde_with_outlier_removal(df_m, 'squid_kelp_diff')\n",
    "\n",
    "# For squid returns\n",
    "plot_kde_with_outlier_removal(df_m, 'squid_mid_ret')\n",
    "\n",
    "# For kelp returns with custom percentiles\n",
    "plot_kde_with_outlier_removal(df_m, 'squid_mid_ret', lower_pct=0.05, upper_pct=0.95)"
