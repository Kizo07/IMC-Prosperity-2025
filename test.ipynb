    "# Create KDE plot for return differences with outlier removal\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "# Calculate percentiles and filter data\n",
    "lower_percentile = df_m['squid_kelp_diff'].quantile(0.01)\n",
